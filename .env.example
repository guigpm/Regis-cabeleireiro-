HOST=127.0.0.1
PORT=3000
# Sem DB_PATH, usa ~/.local/share/rr-barbearia/barbearia.sqlite
# (ou $XDG_DATA_HOME/rr-barbearia/barbearia.sqlite, quando configurado).
# Só configure outro caminho se ele estiver em disco local, fora do NAS/SMB/NFS.
# DB_PATH=/caminho/local/rr-barbearia/barbearia.sqlite
# Defina sua senha entre aspas (12 a 200 caracteres) e reinicie o servidor.
# Quando preenchida, atualiza a senha do painel em cada início, inclusive em bancos existentes.
# Vazia: mantém a senha existente; no primeiro início, gera uma senha aleatória.
ADMIN_PASSWORD=""
# Em produção com HTTPS:
# COOKIE_SECURE=true

# Docker: porta externa e endereço de publicação; DB_PATH acima não é usado no contêiner.
DOCKER_PORT=3000
DOCKER_BIND_IP=127.0.0.1
# Volume persistente no armazenamento do Docker (não na pasta do projeto).
DOCKER_DATA_VOLUME=rr-barbearia-data
