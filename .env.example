HOST=127.0.0.1
PORT=3000
# Sem DB_PATH, usa ~/.local/share/rr-barbearia/barbearia.sqlite
# (ou $XDG_DATA_HOME/rr-barbearia/barbearia.sqlite, quando configurado).
# Só configure outro caminho se ele estiver em disco local, fora do NAS/SMB/NFS.
# DB_PATH=/caminho/local/rr-barbearia/barbearia.sqlite
# Opcional no primeiro início. Sem esta variável, uma senha aleatória é exibida uma vez.
# ADMIN_PASSWORD=uma-senha-longa-e-unica
# Em produção com HTTPS:
# COOKIE_SECURE=true
